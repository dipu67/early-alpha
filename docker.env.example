# Copy to .env (docker compose reads .env automatically):
#   cp docker.env.example .env

# ── Secrets (change these) ──────────────────────────────────────────────
ADMIN_API_KEY=change-me-long-random-string
SESSION_SECRET=change-me-to-a-long-random-string

# ── Postgres ────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Host ports ──────────────────────────────────────────────────────────
API_PORT=4000
ADMIN_PORT=3000

# Admin container talks to API over the compose network (do not use localhost)
# BACKEND_URL=http://api:4000
