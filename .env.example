# Required (API / workers / queues)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379
ADMIN_API_KEY=change-me-long-random-string
# PORT=4000

# Everything else is stored in the database via admin UI:
#   - Telegram bots (telegram_bots)
#   - Alert chat / topics / maps (settings)
#   - Admin Telegram user ids (settings key tg.adminIds)
#   - Grok bot (telegram_bots named Grok, or settings tg.grokBotId)
#   - List owners (project_lists.auth_account_id / auth pool)
