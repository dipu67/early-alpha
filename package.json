{
  "name": "early-alpha",
  "version": "1.0.0",
  "description": "Twitter following tracker for crypto influencers and early project hunters",
  "main": "index.js",
  "scripts": {
    "dev": "tsx index.ts",
    "build": "npx tsc",
    "start": "node dist/index.js",
    "bot": "tsx tg/bots.ts",
    "worker": "tsx services/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "track:init-db": "tsx Tools/following_Track/track.ts init-db",
    "track:import-seeds": "tsx Tools/following_Track/track.ts import-seeds",
    "track:run": "tsx Tools/following_Track/track.ts track",
    "track:run-full": "tsx Tools/following_Track/track.ts track-full",
    "track:digest": "tsx Tools/following_Track/track.ts digest",
    "track:health": "tsx Tools/following_Track/track.ts health",
    "seed-worker": "tsx services/seedWorker.ts"
  },
  "keywords": [],
