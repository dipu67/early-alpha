  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^5.79.1",
    "dotenv": "^17.4.2",
    "grammy": "^1.44.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "ws": "^8.21.0",
    "x-client-transaction-id": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
