# ── early-alpha admin UI (Next.js BFF) ─────────────────────────────────────
# Build from monorepo root: context=. dockerfile=Dockerfile.admin

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY admin/package.json admin/package-lock.json ./
RUN npm ci

FROM deps AS build
WORKDIR /app
COPY admin/ ./
ENV NEXT_TELEMETRY_DISABLED=1
# BACKEND_* only needed at runtime for the BFF proxy; build does not call API
RUN npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Next standalone output (see admin/next.config.ts output: "standalone")
COPY --from=build /app/public ./public
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]
