# ── early-alpha API (+ BullMQ workers, Telegram bots, schedulers) ──────────
# Multi-stage: build TypeScript → slim production image

FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci

FROM deps AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json prisma.config.ts index.ts ./
COPY src ./src
# Generate Prisma client into src/generated/prisma, then compile API
RUN npx prisma generate --schema src/prisma/schema.prisma \
  && npm run build:api \
  && cp -n src/TwitterClient/query-ids.json dist/src/TwitterClient/query-ids.json 2>/dev/null || true

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /app/data

COPY package.json package-lock.json prisma.config.ts ./
RUN npm ci --omit=dev

# Compiled JS + Prisma schema/migrations + generated client (runtime resolve paths)
COPY --from=build /app/dist ./dist
COPY --from=build /app/src/prisma ./src/prisma
COPY --from=build /app/src/generated ./src/generated
# query-ids + any other non-TS assets under TwitterClient
COPY --from=build /app/src/TwitterClient/query-ids.json ./src/TwitterClient/query-ids.json
COPY --from=build /app/dist/src/TwitterClient/query-ids.json ./dist/src/TwitterClient/query-ids.json

COPY scripts/docker-entrypoint-api.sh /app/docker-entrypoint-api.sh
RUN chmod +x /app/docker-entrypoint-api.sh \
  && mkdir -p /app/data

EXPOSE 4000
ENTRYPOINT ["/app/docker-entrypoint-api.sh"]
